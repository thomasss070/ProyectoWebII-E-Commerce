<% const statusCode = typeof status !== "undefined" ? status : (typeof locals.status !== "undefined" ? locals.status : "Error"); %>
<% const mensajeTexto = typeof mensaje !== "undefined" ? mensaje : (typeof locals.mensaje !== "undefined" ? locals.mensaje : ""); %>

<head>
  <meta charset="UTF-8">
  <link rel="stylesheet" href="/Css/main.css">
  <link rel="stylesheet" href="/Css/error.css">
</head>

<div class="error-page">

  <div class="error-container">

    <h1><%= statusCode || "Error" %></h1>

    <h2><%= mensajeTexto %></h2>

    <p>
      <% if (statusCode == 404) { %>
        Pero podés seguir explorando nuestros productos
      <% } else if (statusCode == 500) { %>
        Ocurrió un problema interno. Intentá más tarde.
      <% } else { %>
        Algo salió mal.
      <% } %>
    </p>



    <a href="/" class="btn-inicio">
      Volver al inicio
    </a>

</div>