<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/Css/main.css">
    <link rel="stylesheet" href="/Css/index.css">
</head>

  <div class="container">
    
    <div class = "categorias">
        <a href="#Iphone">Categoria "iPhone"</a>
        <a href="#iPad">Categoria "iPad"</a>
        <a href="#MacBook">Categoria "MacBook"</a>
    </div>

    <form action="/products/order" method="GET" class="form-orden">

    <select name="orden">

        <option value="asc">
            Precio: menor a mayor
        </option>

        <option value="desc">
            Precio: mayor a menor
        </option>

    </select>

    <button type="submit">
        Ordenar
    </button>

</form>
<!-- mas vendidos-->
 <h3 class="mas-vendidos-titulo">Más vendidos</h3> 

<div class="carrusel-wrapper">
  <!-- Botón Izquierda -->
  <button class="carrusel-btn prev" id="btn-prev" aria-label="Anterior">&#10094;</button>

  <div class="mas-vendidos" id="carrusel-productos">
    <% productos.filter(p => p.flag === "true").forEach(p => { %>
      <a href="/products/<%= p.id %>" class="producto-card">
        <img 
          src="<%= p.imagen || '/images/default-placeholder.png' %>" 
          alt="<%= p.nombre %>" 
          class="mas-vendidos-img"
          onerror="this.src='/images/default-placeholder.png'"
        >
        <p class="producto-nombre"><%= p.nombre %></p>
        <p class="producto-precio">$<%= p.precio.toLocaleString() %></p>
        <span class="ver-mas">Ver más</span>
      </a>
    <% }) %>
  </div>

  <!-- Botón Derecha -->
  <button class="carrusel-btn next" id="btn-next" aria-label="Siguiente">&#10095;</button>
</div>

<script>
  const carrusel = document.getElementById('carrusel-productos');
  const btnPrev = document.getElementById('btn-prev');
  const btnNext = document.getElementById('btn-next');

  // Distancia a desplazar al hacer clic (el ancho del contenedor)
  const scrollAmount = () => carrusel.clientWidth;

  btnNext.addEventListener('click', () => {
    carrusel.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
  });

  btnPrev.addEventListener('click', () => {
    carrusel.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
  });
</script>



    <h2 class="categoria-titulo">iPhone</h2>
<ul class="productos" id="Iphone">
  <% productos.filter(p => p.categoria === "iPhone").forEach(p => { %>
    <li>
      <a href="/products/<%= p.id %>">
        <img src="<%= p.imagen %>" alt="<%= p.nombre %>">
        <p><%= p.nombre %></p>
      </a>
    </li>
  <% }) %>
</ul>



<h2 class="categoria-titulo">iPad</h2>
<ul class="productos" id="iPad">
  <% productos.filter(p => p.categoria === "iPad").forEach(p => { %>
    <li>
      <a href="/products/<%= p.id %>">
        <img src="<%= p.imagen %>" alt="<%= p.nombre %>">
        <p><%= p.nombre %></p>
      </a>
    </li>
  <% }) %>
</ul>



<h2 class="categoria-titulo">MacBook</h2>

<ul class="productos" id="MacBook">

  <% productos.filter(p => p.categoria === "MacBook").forEach(p => { %>

    <li>

      <a href="<%= p.id === 12 ? '/error' : '/products/' + p.id %>">

        <img src="<%= p.imagen %>" alt="<%= p.nombre %>">

        <p><%= p.nombre %></p>

      </a>

    </li>

  <% }) %>

</ul>

  </div>

  <div class="Interes-container">

    <h2>También te puede interesar</h2>

    <ul class="productos">

      <% [...productos]
    .sort(() => 0.5 - Math.random())
    .slice(0, 5)
    .forEach(p => { %>

        <li>

          <a href="/products/<%= p.id %>">

            <img src="<%= p.imagen %>" alt="<%= p.nombre %>">

            <p><%= p.nombre %></p>

            <p><%= p.precio.toLocaleString() %></p>

            <p>Click para ver mas</p>

          </a>

        </li>

      <% }) %>

    </ul>

  </div>

